# Copy this file to ".env" and fill in your Azure AI Foundry values.
# Find these in the Azure AI Foundry portal on your o4-mini deployment page.

# The base resource URL, e.g. https://my-resource.openai.azure.com
AZURE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com

# The API key for that resource (Keys and Endpoint section)
AZURE_API_KEY=your-azure-key-here

# The name YOU gave the deployment when you deployed o4-mini
AZURE_DEPLOYMENT=o4-mini

# API version (leave as-is unless the portal shows a different one)
AZURE_API_VERSION=2024-12-01-preview

# Port the local proxy listens on
PORT=8787
